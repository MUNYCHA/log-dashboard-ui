# WebSocket server URL for real-time log streaming
VITE_WS_URL=ws://localhost:8080/ws/logs

# Max logs kept in memory per topic (higher = more context, more RAM)
VITE_MAX_LOGS_PER_TOPIC=500

# Truncate log messages longer than this (characters) to prevent DOM bloat
VITE_MAX_MESSAGE_LENGTH=50000

# Storage monitoring REST API base URL (separate from WebSocket log server)
VITE_STORAGE_API_URL=http://localhost:8081

# SSO authentication — leave empty for local dev (auth guard is skipped when not configured)
VITE_SSO_LOGIN_URL=
VITE_SSO_LOGOUT_URL=
VITE_SSO_TOKEN_URL=
VITE_SSO_CLIENT_ID=
# VITE_SSO_REDIRECT_URI defaults to window.location.origin + /callback — override if needed
# VITE_SSO_REDIRECT_URI=https://yourdomain.com/callback
