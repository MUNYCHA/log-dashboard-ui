# Standalone UI development/build configuration only.
# The office server deployment is configured from ../log-infra/.env instead.
#
# ── Same-origin deployment (default) ──────────────────────────────────────────
# The UI, REST API, WebSocket, and Keycloak are all served behind ONE nginx on
# the same origin. By default the app derives every endpoint from the page's own
# origin at runtime (see src/config.js), so for a standard proxied deploy leave
# VITE_WS_URL / VITE_SSO_LOGIN_URL blank.
#
# The UI bundle does not need a rebuild when the office IP changes, but the API's
# LOGSTREAM_ALLOWED_ORIGINS plus Keycloak hostname and client redirect/web origin
# settings must still match the browser-visible origin.
#
# Only set the override vars below if Keycloak or the combined REST/WebSocket API
# lives on a different origin than the UI. REST uses the origin derived from
# VITE_WS_URL; independent REST and WebSocket origins are not configured here.

# Optional override — explicit WebSocket URL (leave blank for same-origin).
# e.g. wss://10.0.0.5/ws/logs or wss://logs.example.com/ws/logs
VITE_WS_URL=

# Optional override — Keycloak realm URL for oidc-client-ts auto-discovery.
# Leave blank to use <page-origin>/auth/realms/logstream
VITE_SSO_LOGIN_URL=

# REQUIRED in prod — enables SSO. Must match the clientId in the Keycloak realm.
# When blank (e.g. local `npm run dev`) SSO is disabled and the UI runs unauthenticated.
VITE_SSO_CLIENT_ID=logstream-ui

# ── Display tuning ────────────────────────────────────────────────────────────
# Max logs kept in memory per topic (higher = more context, more RAM)
VITE_MAX_LOGS_PER_TOPIC=500

# Truncate log messages longer than this (characters) to prevent DOM bloat
VITE_MAX_MESSAGE_LENGTH=50000
